---
import { Image } from 'astro:assets';
import { STATUTS_LOCAL, lien, type StatutLocal } from '../lib/site';
import { formaterSurface, type Local } from '../lib/contenu';

/**
 * Carte d'un local dans la liste. Calquée sur CarteCommerce pour que la
 * grille reste homogène d'une page à l'autre, avec en plus le couple
 * surface / disponibilité — les deux seules informations qu'un porteur de
 * projet regarde avant de cliquer.
 */
interface Props {
  local: Local;
  prioritaire?: boolean;
}

const { local, prioritaire = false } = Astro.props;
const { reference, surface, statut, disponibilite, accroche, image, video } =
  local.data;

const badge = STATUTS_LOCAL[statut as StatutLocal];
const libelleSurface = formaterSurface(surface);

/**
 * Un local vide se photographie mal en vignette ; la teinte pleine avec la
 * surface en gros caractères se lit mieux qu'une photo de mur nu, et évite
 * un placeholder « photo à venir » qui ferait négligé sur une annonce.
 */
const teintes: Record<string, string> = {
  disponible: 'var(--color-terracotta-500)',
  reserve: 'var(--color-albizia-500)',
  loue: 'var(--color-albizia-400)',
};
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-[--radius-card] border bg-white transition-shadow hover:shadow-md focus-within:shadow-md',
    statut === 'loue' ? 'border-albizia-100 opacity-75' : 'border-albizia-200',
  ]}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-white">
    {
      image ? (
        <Image
          src={image}
          alt={`Vue aérienne du pôle commercial l'Albizia, ${reference} signalé en rouge`}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
          loading={prioritaire ? 'eager' : 'lazy'}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : video ? (
        /* Le poster de la vidéo suffit en vignette : on ne lance pas trois
           lectures simultanées dans une grille. */
        <img
          src={lien(`/videos/${video}.jpg`)}
          alt={`Local ${reference} à louer au pôle commercial l'Albizia`}
          loading={prioritaire ? 'eager' : 'lazy'}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="vignette-placeholder flex h-full w-full flex-col items-center justify-center gap-1"
          style={`--teinte: ${teintes[statut] ?? 'var(--color-albizia-400)'}`}
          role="img"
          aria-label={`Local ${reference}${libelleSurface ? `, ${libelleSurface}` : ''}`}
        >
          <span class="text-3xl font-bold tracking-tight text-white drop-shadow-sm">
            {libelleSurface ?? reference}
          </span>
          {libelleSurface && (
            <span class="text-sm font-medium text-white/80">{reference}</span>
          )}
        </div>
      )
    }

    <span
      class:list={[
        'absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide',
        statut === 'disponible'
          ? 'bg-terracotta-600 text-white'
          : 'bg-white/90 text-albizia-700',
      ]}
    >
      {badge.label}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-lg font-semibold leading-snug text-albizia-900">
      <a href={lien(`/locaux/${local.id}`)} class="after:absolute after:inset-0">
        {reference}
        {libelleSurface && <span class="text-albizia-600"> · {libelleSurface}</span>}
      </a>
    </h3>
    <p class="text-sm leading-relaxed text-albizia-700">{accroche}</p>
    <p class="mt-auto pt-2 text-xs font-medium uppercase tracking-wide text-albizia-600">
      Disponibilité : {disponibilite}
    </p>
  </div>
</article>
