---
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import SelecteurLangue from './SelecteurLangue.astro';
import { t, type Locale } from '../i18n';
import { chemin, type CleRoute } from '../i18n/routes';
import { nav } from '../i18n/navigation';
import logo from '../assets/logo-albizia.png';

interface Props {
  locale: Locale;
  cleRoute: CleRoute;
  segmentRoute?: string;
}

const { locale, cleRoute, segmentRoute } = Astro.props;

const entrees = nav(locale);
const accueil = chemin('accueil', locale);
const cheminCourant = Astro.url.pathname.replace(/\/$/, '') || '/';

/*
 * L'accueil ne doit pas s'allumer sur toutes les pages : sa comparaison est
 * stricte. En anglais son chemin est `/en`, jamais `/` — d'où la comparaison
 * au chemin d'accueil calculé plutôt qu'au littéral '/'.
 */
const estActif = (href: string) =>
  cheminCourant === href || (href !== accueil && cheminCourant.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-albizia-100 bg-sable-50/95 backdrop-blur">
  <div class="conteneur flex items-center justify-between gap-4 py-3">
    <!--
      Le logo est décoratif (alt vide) : le nom est déjà porté par le texte
      à côté, un alt le ferait annoncer deux fois par un lecteur d'écran.
    -->
    <a
      href={accueil}
      class="flex items-center gap-2.5 rounded-md text-albizia-800 transition-colors hover:text-terracotta-600"
    >
      <Image
        src={logo}
        alt=""
        width={108}
        widths={[54, 108]}
        sizes="(min-width: 640px) 54px, 44px"
        loading="eager"
        class="h-9 w-auto shrink-0 sm:h-11"
      />
      <span class="flex flex-col leading-tight">
        <span class="text-base font-semibold tracking-tight sm:text-lg">
          {SITE.nomCourt}
        </span>
        <span class="text-[0.7rem] font-medium text-albizia-500">
          {t(locale, 'entete.sousTitre')}
        </span>
      </span>
    </a>

    <!-- Navigation bureau -->
    <div class="hidden items-center gap-2 lg:flex">
      <nav aria-label={t(locale, 'a11y.navPrincipale')}>
      <ul class="flex items-center gap-1">
        {
          entrees.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={estActif(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  estActif(item.href)
                    ? 'bg-albizia-100 text-albizia-800'
                    : 'text-albizia-700 hover:bg-albizia-50 hover:text-albizia-900',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      </nav>
      <SelecteurLangue
        locale={locale}
        cleRoute={cleRoute}
        segmentRoute={segmentRoute}
        class="border-l border-albizia-200 pl-2"
      />
    </div>

    <!-- Navigation mobile : <details> pour fonctionner sans JavaScript -->
    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer items-center gap-2 rounded-md border border-albizia-200 px-3 py-2 text-sm font-medium text-albizia-800 marker:content-none [&::-webkit-details-marker]:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            class="group-open:hidden"
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
          <path
            class="hidden group-open:block"
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <span>{t(locale, 'entete.menu')}</span>
      </summary>
      <div class="absolute right-0 top-full mt-2 w-60 rounded-xl border border-albizia-100 bg-white p-2 shadow-lg">
      <nav aria-label={t(locale, 'a11y.navPrincipale')}>
        <ul class="flex flex-col">
          {
            entrees.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={estActif(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-2.5 text-sm font-medium transition-colors',
                    estActif(item.href)
                      ? 'bg-albizia-100 text-albizia-800'
                      : 'text-albizia-700 hover:bg-albizia-50',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <SelecteurLangue
        locale={locale}
        cleRoute={cleRoute}
        segmentRoute={segmentRoute}
        class="mt-2 border-t border-albizia-100 px-2 pt-2"
      />
      </div>
    </details>
  </div>
</header>
