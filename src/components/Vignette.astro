---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CategorieId } from '../lib/site';
import { dico, type Locale } from '../i18n';

/**
 * Vignette d'une enseigne : la vraie photo si elle existe, sinon un
 * placeholder coloré par catégorie portant les initiales. Remplacer une
 * vignette = ajouter `image:` au frontmatter, rien d'autre à toucher.
 *
 * Deux cadrages : une photo de devanture remplit le cadre (`object-cover`),
 * un logo tient entier dans le cadre (`object-contain`), le fond blanc
 * comblant les marges. Les logos ont des ratios trop hétérogènes (2.1 à
 * 0.94) pour remplir un 4/3 sans déformation ni recadrage : les contenir
 * est le seul cadrage qui ne perde aucun logo, notamment sur mobile où
 * une carte pleine largeur amplifie tout débordement.
 */
interface Props {
  nom: string;
  locale: Locale;
  categorie: CategorieId | string;
  image?: ImageMetadata;
  /** L'image est un logo, pas une photo : affiché entier dans le cadre. */
  logo?: boolean;
  class?: string;
  /** Charge l'image en priorité (au-dessus de la ligne de flottaison). */
  prioritaire?: boolean;
}

const {
  nom,
  locale,
  categorie,
  image,
  logo = false,
  class: classe = '',
  prioritaire = false,
} = Astro.props;

const textes = dico(locale).a11y;

const teintes: Record<string, string> = {
  beaute: 'var(--color-terracotta-400)',
  restauration: 'var(--color-terracotta-500)',
  auto: 'var(--color-albizia-600)',
  services: 'var(--color-albizia-500)',
  commerce: 'var(--color-albizia-400)',
  artisanat: 'var(--color-terracotta-300)',
};

const teinte = teintes[categorie] ?? 'var(--color-albizia-400)';

const initiales = nom
  .replace(/[^\p{L}\p{N}\s]/gu, ' ')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((mot) => mot[0]!.toUpperCase())
  .join('');
---

{
  image ? (
    logo ? (
      <div class="flex h-full w-full items-center justify-center overflow-hidden bg-white p-4">
        <Image
          src={image}
          alt={textes.altLogo(nom)}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
          loading={prioritaire ? 'eager' : 'lazy'}
          class:list={['h-full w-full object-contain', classe]}
        />
      </div>
    ) : (
      <Image
        src={image}
        alt={textes.altDevanture(nom)}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
        loading={prioritaire ? 'eager' : 'lazy'}
        class:list={['h-full w-full object-cover', classe]}
      />
    )
  ) : (
    <div
      class:list={[
        'vignette-placeholder flex h-full w-full items-center justify-center',
        classe,
      ]}
      style={`--teinte: ${teinte}`}
      role="img"
      aria-label={textes.ariaPhotoAvenir(nom)}
    >
      <span class="text-3xl font-bold tracking-wide text-white/90 drop-shadow-sm">
        {initiales}
      </span>
    </div>
  )
}
