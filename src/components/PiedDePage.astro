---
import { ADRESSE, CONTACT, HORAIRES, NAV_PIED, SITE, lien } from '../lib/site';

const annee = new Date().getFullYear();
---

<footer class="mt-20 border-t border-albizia-100 bg-albizia-800 text-albizia-100">
  <div class="conteneur grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-semibold text-white">{SITE.nom}</p>
      <address class="mt-3 not-italic text-sm leading-relaxed text-albizia-200">
        {ADRESSE.rue}<br />
        {ADRESSE.codePostal}
        {ADRESSE.ville}<br />
        <span class="text-albizia-300">
          En bordure de la RD 928 — avenue de Montauban
        </span>
      </address>
      {
        CONTACT.telephone && (
          <p class="mt-3 text-sm">
            <a
              href={`tel:${CONTACT.telephone.replace(/\s/g, '')}`}
              class="rounded font-medium text-white underline decoration-albizia-400 underline-offset-4 hover:decoration-terracotta-300"
            >
              {CONTACT.telephone}
            </a>
          </p>
        )
      }
      <p class="mt-4 text-sm text-albizia-200">
        Parking gratuit · Accès PMR · Services 24h/24
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-albizia-300">
        Le site
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV_PIED.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded text-albizia-100 transition-colors hover:text-white hover:underline underline-offset-4"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-albizia-300">
        Horaires du site
      </h2>
      <dl class="mt-3 space-y-1.5 text-sm">
        {
          HORAIRES.jours.map((h) => (
            <div class="flex flex-col">
              <dt class="text-albizia-300">{h.jours}</dt>
              <dd class="font-medium text-white">{h.horaire}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-xs leading-relaxed text-albizia-300">
        Horaires indicatifs des parties communes.
      </p>
    </div>
  </div>

  <div class="border-t border-albizia-700">
    <div
      class="conteneur flex flex-col items-start justify-between gap-3 py-5 text-xs text-albizia-300 sm:flex-row sm:items-center"
    >
      <p>© {annee} {SITE.nom}. Tous droits réservés.</p>
      <a
        href={lien('/mentions-legales')}
        class="rounded transition-colors hover:text-white hover:underline underline-offset-4"
      >
        Mentions légales
      </a>
    </div>
  </div>
</footer>
