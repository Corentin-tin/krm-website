---
import { ADRESSE, CONTACT, HORAIRES, SITE } from '../lib/site';
import { getPermanents } from '../lib/contenu';
import SelecteurLangue from './SelecteurLangue.astro';
import { dico, t, type Locale } from '../i18n';
import { chemin, type CleRoute } from '../i18n/routes';
import { navPied } from '../i18n/navigation';

interface Props {
  locale: Locale;
  cleRoute: CleRoute;
  segmentRoute?: string;
}

const { locale, cleRoute, segmentRoute } = Astro.props;
const entrees = navPied(locale);
const textes = dico(locale);
const annee = new Date().getFullYear();

/*
 * Les horaires affichés sont ceux des parties communes. Sans cette précision,
 * un visiteur venu retirer un colis à 7h lit « Dimanche 11h00 – 23h00 » et
 * repart : la liste est dérivée du contenu (`permanent: true`) pour rester
 * juste si un équipement 24h/24 est ajouté ou retiré.
 */
const permanents = await getPermanents(locale);
---

<footer class="mt-20 border-t border-albizia-100 bg-albizia-800 text-albizia-100">
  <div class="conteneur grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-semibold text-white">{SITE.nom}</p>
      <address class="mt-3 not-italic text-sm leading-relaxed text-albizia-200">
        {ADRESSE.rue}<br />
        {ADRESSE.codePostal}
        {ADRESSE.ville}<br />
        <span class="text-albizia-300">
          {t(locale, 'pied.situation')}
        </span>
      </address>
      {
        CONTACT.telephone && (
          <p class="mt-3 text-sm">
            <a
              href={`tel:${CONTACT.telephone.replace(/\s/g, '')}`}
              class="rounded font-medium text-white underline decoration-albizia-400 underline-offset-4 hover:decoration-terracotta-300"
            >
              {CONTACT.telephone}
            </a>
          </p>
        )
      }
      <p class="mt-4 text-sm text-albizia-200">
        {t(locale, 'pied.arguments')}
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-albizia-300">
        {t(locale, 'pied.colonneSite')}
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          entrees.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded text-albizia-100 transition-colors hover:text-white hover:underline underline-offset-4"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-albizia-300">
        {t(locale, 'commun.horairesTitre')}
      </h2>
      <dl class="mt-3 space-y-1.5 text-sm">
        {
          HORAIRES.jours.map((h) => (
            <div class="flex flex-col">
              <dt class="text-albizia-300">{t(locale, h.jours)}</dt>
              <dd class="font-medium text-white">{t(locale, h.horaire)}</dd>
            </div>
          ))
        }
      </dl>
      {
        permanents.length > 0 && (
          <p class="mt-3 text-xs leading-relaxed text-albizia-200">
            <span class="font-medium text-white">{t(locale, 'commun.accessibles24h')}</span>{' '}
            {permanents.map((p) => p.nom).join(', ')}.
          </p>
        )
      }
      <p class="mt-3 text-xs leading-relaxed text-albizia-300">
        {t(locale, 'pied.horairesMentionCourte')}
      </p>
    </div>
  </div>

  <div class="border-t border-albizia-700">
    <div
      class="conteneur flex flex-col items-start justify-between gap-3 py-5 text-xs text-albizia-300 sm:flex-row sm:items-center"
    >
      <p>{textes.pied.copyright(annee, SITE.nom)}</p>
      <div class="flex items-center gap-4">
        <a
          href={chemin('mentionsLegales', locale)}
          class="rounded transition-colors hover:text-white hover:underline underline-offset-4"
        >
          {t(locale, 'nav.mentionsLegales')}
        </a>
        <SelecteurLangue
          locale={locale}
          cleRoute={cleRoute}
          segmentRoute={segmentRoute}
          variante="pied"
        />
      </div>
    </div>
  </div>
</footer>
