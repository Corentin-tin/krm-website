---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import CarteLocal from '../components/CarteLocal.astro';
import ContactAgence from '../components/ContactAgence.astro';
import Icone from '../components/Icone.astro';
import { schemaFilAriane } from '../lib/seo';
import { ADRESSE_COMPLETE, AGENCE, CONTACT, CONTACT_FICHES, SITE } from '../lib/site';
import { getCommerces, getLocaux, getLocauxDisponibles, idPublic } from '../lib/contenu';
import { dico, t, type Locale } from '../i18n';
import { chemin, urlAbsolue } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const textes = dico(locale);

const locaux = await getLocaux(locale);
const disponibles = await getLocauxDisponibles(locale);
const commerces = await getCommerces(locale);

const siteUrl = Astro.site!.href;
const urlPage = urlAbsolue('contact', locale, siteUrl);

const schemas = [
  schemaFilAriane([
    { nom: t(locale, 'commun.accueil'), url: urlAbsolue('accueil', locale, siteUrl) },
    { nom: t(locale, 'nav.contact'), url: urlPage },
  ]),
  ...(disponibles.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: textes.contact.listeNom(SITE.nom),
          numberOfItems: disponibles.length,
          itemListElement: disponibles.map((l, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: l.data.reference,
            url: urlAbsolue('locaux', locale, siteUrl, idPublic(l.id)),
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  titre={textes.contact.metaTitre}
  description={textes.contact.metaDescription(SITE.nom)}
  locale={locale}
  cleRoute="contact"
  schemas={schemas}
>
  <EnTetePage video="contact" titre={textes.contact.titre} intro={textes.contact.intro} />

  <div class="conteneur py-14 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-14">
      <section>
        <h2 class="text-xl font-bold tracking-tight text-albizia-900">
          {textes.contact.coordonnees}
        </h2>

        <dl class="mt-5 space-y-5">
          <div>
            <dt class="flex items-center gap-1.5 text-sm font-medium text-albizia-600">
              <Icone nom="localisation" class="h-4 w-4" />
              {t(locale, 'commun.adresse')}
            </dt>
            <dd class="mt-1.5">
              <address class="not-italic leading-relaxed text-albizia-900">
                {SITE.nom}<br />
                {ADRESSE_COMPLETE}
              </address>
            </dd>
          </div>

          {
            CONTACT.telephone && (
              <div>
                <dt class="text-sm font-medium text-albizia-600">
                  {textes.contact.telephone}
                </dt>
                <dd class="mt-1.5">
                  <a
                    href={`tel:${CONTACT.telephone.replace(/\s/g, '')}`}
                    class="rounded text-lg font-semibold text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                  >
                    {CONTACT.telephone}
                  </a>
                </dd>
              </div>
            )
          }

          {
            CONTACT.email && (
              <div>
                <dt class="text-sm font-medium text-albizia-600">
                  {textes.contact.courriel}
                </dt>
                <dd class="mt-1.5">
                  <a
                    href={`mailto:${CONTACT.email}`}
                    class="rounded break-all font-semibold text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                  >
                    {CONTACT.email}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </section>

      <section>
        <h2 class="text-xl font-bold tracking-tight text-albizia-900">
          {textes.contact.selonDemande}
        </h2>

        <ul class="mt-5 space-y-4">
          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              {textes.contact.chercheCommerceTitre}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              {textes.contact.chercheCommerceTexte}
            </p>
            <a
              href={chemin('commerces', locale)}
              class="mt-3 inline-block rounded text-sm font-semibold text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
            >
              {textes.contact.chercheCommerceCta}
            </a>
          </li>

          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              {textes.contact.louerTitre}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              {textes.contact.louerTexte(disponibles.length, AGENCE.nom)}
            </p>
            {
              disponibles.length > 0 && (
                <a
                  href="#locaux"
                  class="mt-3 inline-block rounded text-sm font-semibold text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
                >
                  {textes.contact.louerCta}
                </a>
              )
            }
          </li>

          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              {textes.contact.commercantTitre}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              {textes.contact.commercantTexte}
            </p>
            <a
              href={`mailto:${CONTACT_FICHES}?subject=${encodeURIComponent(
                textes.contact.mailSujet(SITE.nom),
              )}`}
              class="mt-3 inline-block rounded text-sm font-semibold text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
            >
              {textes.contact.commercantCta}
            </a>
          </li>
        </ul>
      </section>
    </div>

    <!--
      Les locaux à louer. Rattachés à la page contact plutôt qu'à une section
      dédiée : la demande arrive par le même canal que les autres, et chaque
      local garde sa fiche pour le référencement (« local commercial 90 m²
      à louer Montech »).
    -->
    {
      locaux.length > 0 && (
        <section id="locaux" class="mt-16 scroll-mt-24 border-t border-albizia-100 pt-14">
          <h2 class="text-xl font-bold tracking-tight text-albizia-900 sm:text-2xl">
            {textes.contact.locauxTitre}
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-albizia-700">
            {textes.contact.locauxIntro(commerces.length)}
          </p>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {locaux.map((local) => (
              <li class="flex">
                <CarteLocal local={local} locale={locale} />
              </li>
            ))}
          </ul>

          <ContactAgence locale={locale} class="mt-10" />
        </section>
      )
    }
  </div>
</BaseLayout>
