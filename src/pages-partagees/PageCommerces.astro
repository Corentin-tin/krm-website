---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import CarteCommerce from '../components/CarteCommerce.astro';
import { schemaFilAriane } from '../lib/seo';
import { SITE } from '../lib/site';
import { getCommerces, getCommercesParCategorie, idPublic } from '../lib/contenu';
import { dico, t, type Locale } from '../i18n';
import { chemin, urlAbsolue } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const textes = dico(locale);
const commerces = await getCommerces(locale);
const groupes = await getCommercesParCategorie(locale);

const siteUrl = Astro.site!.href;
const schemas = [
  schemaFilAriane([
    { nom: t(locale, 'commun.accueil'), url: urlAbsolue('accueil', locale, siteUrl) },
    { nom: t(locale, 'nav.commerces'), url: urlAbsolue('commerces', locale, siteUrl) },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: textes.commerces.listeNom(SITE.nom),
    numberOfItems: commerces.length,
    itemListElement: commerces.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.data.nom,
      url: urlAbsolue('commerces', locale, siteUrl, idPublic(c.id)),
    })),
  },
];
---

<BaseLayout
  titre={textes.commerces.metaTitre}
  description={textes.commerces.metaDescription(SITE.nom)}
  locale={locale}
  cleRoute="commerces"
  schemas={schemas}
>
  <EnTetePage
    video="commerces"
    titre={textes.commerces.titre}
    intro={textes.commerces.intro}
  >
    {
      groupes.length > 1 && (
        <nav aria-label={t(locale, 'a11y.allerCategorie')} class="mt-8">
          <ul class="flex flex-wrap gap-2">
            {groupes.map((groupe) => (
              <li>
                <a
                  href={`#${groupe.id}`}
                  class="inline-block rounded-full border border-white/40 bg-white/10 px-4 py-2 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/70 hover:bg-white/20"
                >
                  {groupe.label}
                  <span class="ml-1.5 text-white/70">
                    {groupe.commerces.length}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </EnTetePage>

  <div class="conteneur py-14 sm:py-16">
    {
      groupes.length === 0 ? (
        <p class="text-albizia-700">{textes.commerces.vide}</p>
      ) : (
        <div class="space-y-16">
          {groupes.map((groupe) => (
            <section id={groupe.id} class="scroll-mt-24">
              <h2 class="text-xl font-bold tracking-tight text-albizia-900 sm:text-2xl">
                {groupe.label}
              </h2>
              <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {groupe.commerces.map((commerce) => (
                  <li class="flex">
                    <CarteCommerce commerce={commerce} locale={locale} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    <aside class="mt-16 rounded-[--radius-card] border border-albizia-200 bg-sable-100 p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-albizia-900">
        {textes.commerces.encartTitre}
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-albizia-700">
        {textes.commerces.encartTexte}
      </p>
      <a
        href={chemin('contact', locale)}
        class="mt-4 inline-block rounded-lg bg-albizia-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-albizia-800"
      >
        {t(locale, 'commun.nousContacter')}
      </a>
    </aside>
  </div>
</BaseLayout>
