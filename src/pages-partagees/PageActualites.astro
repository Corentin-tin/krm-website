---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import { schemaFilAriane } from '../lib/seo';
import { SITE } from '../lib/site';
import { formaterDate, getActualites, idPublic } from '../lib/contenu';
import { dico, t, type Locale } from '../i18n';
import { chemin, urlAbsolue } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const textes = dico(locale);
const actualites = await getActualites(locale);

const siteUrl = Astro.site!.href;
const schemas = [
  schemaFilAriane([
    { nom: t(locale, 'commun.accueil'), url: urlAbsolue('accueil', locale, siteUrl) },
    { nom: t(locale, 'nav.actualites'), url: urlAbsolue('actualites', locale, siteUrl) },
  ]),
];
---

<BaseLayout
  titre={textes.actualites.metaTitre}
  description={textes.actualites.metaDescription(SITE.nom)}
  locale={locale}
  cleRoute="actualites"
  schemas={schemas}
>
  <EnTetePage titre={textes.actualites.titre} intro={textes.actualites.intro} />

  <div class="conteneur py-14 sm:py-16">
    {
      actualites.length === 0 ? (
        <p class="text-albizia-700">{textes.actualites.vide}</p>
      ) : (
        <ul class="space-y-6">
          {actualites.map((article) => (
            <li class="group relative rounded-[--radius-card] border border-albizia-100 bg-white p-6 transition-shadow hover:shadow-md sm:p-8">
              <time
                datetime={article.data.date.toISOString()}
                class="text-xs font-semibold uppercase tracking-wide text-terracotta-600"
              >
                {formaterDate(article.data.date, locale)}
              </time>
              <h2 class="mt-2 text-xl font-bold leading-snug tracking-tight text-albizia-900 sm:text-2xl">
                <a
                  href={chemin('actualites', locale, idPublic(article.id))}
                  class="after:absolute after:inset-0"
                >
                  {article.data.titre}
                </a>
              </h2>
              <p class="mt-3 max-w-3xl leading-relaxed text-albizia-700">
                {article.data.resume}
              </p>
              {article.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {article.data.tags.map((tag) => (
                    <li class="rounded-full bg-albizia-50 px-3 py-1 text-xs font-medium text-albizia-700">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
