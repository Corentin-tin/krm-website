---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Vignette from '../components/Vignette.astro';
import Icone from '../components/Icone.astro';
import LiensEnseigne from '../components/LiensEnseigne.astro';
import FilAriane from '../components/FilAriane.astro';
import { schemaCommerce, schemaFilAriane } from '../lib/seo';
import { ADRESSE_COMPLETE, SITE, type CategorieId } from '../lib/site';
import { idPublic, langueEntree, type Commerce } from '../lib/contenu';
import { dico, t, type Locale } from '../i18n';
import { chemin, urlAbsolue } from '../i18n/routes';

interface Props {
  locale: Locale;
  commerce: Commerce;
}

const { locale, commerce } = Astro.props;
// `telephone` n'est plus affiché : il ne sert qu'au balisage schema.org.
const { nom, categorie, accroche, telephone, siteWeb, googleMaps, reseaux, image, logo } =
  commerce.data;

const textes = dico(locale);
const { Content } = await render(commerce);

const label = textes.categories[categorie as CategorieId] ?? categorie;
const siteUrl = Astro.site!.href;
const segment = idPublic(commerce.id);
const urlPage = urlAbsolue('commerces', locale, siteUrl, segment);

/* La fiche peut être servie en repli : son `inLanguage` est celui du fichier. */
const langueFiche = langueEntree(commerce.id);

const filAriane = [
  { label: t(locale, 'commun.accueil'), href: chemin('accueil', locale) },
  { label: t(locale, 'nav.commerces'), href: chemin('commerces', locale) },
  { label: nom },
];

const schemas = [
  schemaCommerce({
    nom,
    description: accroche,
    url: urlPage,
    siteUrl,
    telephone,
    siteWeb,
    locale: langueFiche,
  }),
  schemaFilAriane([
    { nom: t(locale, 'commun.accueil'), url: urlAbsolue('accueil', locale, siteUrl) },
    { nom: t(locale, 'nav.commerces'), url: urlAbsolue('commerces', locale, siteUrl) },
    { nom, url: urlPage },
  ]),
];
---

<BaseLayout
  titre={nom}
  description={textes.commerce.metaDescription(accroche, nom, ADRESSE_COMPLETE)}
  locale={locale}
  cleRoute="commerces"
  segmentRoute={segment}
  schemas={schemas}
>
  <div class="conteneur py-8 sm:py-12">
    <FilAriane locale={locale} items={filAriane} />

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <!-- Colonne principale -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-terracotta-600">
          {label}
        </p>
        <h1
          class="mt-2 text-3xl font-bold tracking-tight text-albizia-900 sm:text-4xl"
          lang={langueFiche !== locale ? langueFiche : undefined}
        >
          {nom}
        </h1>
        <p
          class="mt-4 text-lg leading-relaxed text-albizia-700"
          lang={langueFiche !== locale ? langueFiche : undefined}
        >
          {accroche}
        </p>

        <div class="mt-8 aspect-[16/9] overflow-hidden rounded-[--radius-card] bg-white">
          <Vignette
            nom={nom}
            locale={locale}
            categorie={categorie}
            image={image}
            logo={logo}
            prioritaire
          />
        </div>

        <div
          class="prose-albizia mt-8 max-w-none space-y-4 leading-relaxed text-albizia-800 [&_a]:font-medium [&_a]:text-albizia-700 [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-4 [&_blockquote]:border-albizia-200 [&_blockquote]:pl-4 [&_blockquote]:text-sm [&_blockquote]:text-albizia-600 [&_strong]:font-semibold [&_strong]:text-albizia-900"
          lang={langueFiche !== locale ? langueFiche : undefined}
        >
          <Content />
        </div>
      </div>

      <!-- Colonne latérale : informations pratiques -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[--radius-card] border border-albizia-200 bg-white p-6">
          <h2 class="text-base font-semibold text-albizia-900">
            {textes.commerce.infosPratiques}
          </h2>

          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="flex items-center gap-1.5 font-medium text-albizia-600">
                <Icone nom="localisation" class="h-4 w-4" />
                {t(locale, 'commun.adresse')}
              </dt>
              <dd class="mt-1 text-albizia-900">
                <address class="not-italic">
                  {SITE.nom}<br />
                  {ADRESSE_COMPLETE}
                </address>
              </dd>
            </div>
          </dl>

          <LiensEnseigne
            nom={nom}
            locale={locale}
            siteWeb={siteWeb}
            googleMaps={googleMaps}
            reseaux={reseaux}
            class="mt-6 border-t border-albizia-100 pt-5"
          />

          <p class="mt-6 border-t border-albizia-100 pt-4 text-xs leading-relaxed text-albizia-600">
            {t(locale, 'commun.parkingPlainPied')}
          </p>
        </div>

        <a
          href={chemin('commerces', locale)}
          class="mt-4 inline-block rounded text-sm font-medium text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
        >
          {textes.commerce.retour}
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>
