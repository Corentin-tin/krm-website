---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import { schemaFilAriane } from '../../lib/seo';
import { SITE, lien } from '../../lib/site';
import { formaterDate, getActualites } from '../../lib/contenu';

const actualites = await getActualites();

const siteUrl = Astro.site!.href;
const schemas = [
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Actualités', url: new URL('/actualites', siteUrl).href },
  ]),
];
---

<BaseLayout
  titre="Actualités"
  description={`Nouvelles enseignes, nouveaux services et animations du ${SITE.nom} à Montech.`}
  schemas={schemas}
>
  <EnTetePage
    titre="Actualités du pôle"
    intro="Nouvelles enseignes, nouveaux services, animations : ce qui bouge à l'Albizia."
  />

  <div class="conteneur py-14 sm:py-16">
    {
      actualites.length === 0 ? (
        <p class="text-albizia-700">Aucune actualité pour le moment.</p>
      ) : (
        <ul class="space-y-6">
          {actualites.map((article) => (
            <li class="group relative rounded-[--radius-card] border border-albizia-100 bg-white p-6 transition-shadow hover:shadow-md sm:p-8">
              <time
                datetime={article.data.date.toISOString()}
                class="text-xs font-semibold uppercase tracking-wide text-terracotta-600"
              >
                {formaterDate(article.data.date)}
              </time>
              <h2 class="mt-2 text-xl font-bold leading-snug tracking-tight text-albizia-900 sm:text-2xl">
                <a
                  href={lien(`/actualites/${article.id}`)}
                  class="after:absolute after:inset-0"
                >
                  {article.data.titre}
                </a>
              </h2>
              <p class="mt-3 max-w-3xl leading-relaxed text-albizia-700">
                {article.data.resume}
              </p>
              {article.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {article.data.tags.map((tag) => (
                    <li class="rounded-full bg-albizia-50 px-3 py-1 text-xs font-medium text-albizia-700">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
