---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { schemaFilAriane } from '../../lib/seo';
import { SITE, lien } from '../../lib/site';
import { formaterDate, getActualites } from '../../lib/contenu';

export async function getStaticPaths() {
  const actualites = await getActualites();
  return actualites.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { titre, date, resume, tags } = article.data;
const { Content } = await render(article);

const siteUrl = Astro.site!.href;
const urlPage = new URL(`/actualites/${article.id}`, siteUrl).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: titre,
    description: resume,
    datePublished: date.toISOString(),
    url: urlPage,
    publisher: {
      '@type': 'Organization',
      name: SITE.nom,
      url: siteUrl,
    },
  },
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Actualités', url: new URL('/actualites', siteUrl).href },
    { nom: titre, url: urlPage },
  ]),
];
---

<BaseLayout titre={titre} description={resume} schemas={schemas}>
  <article class="conteneur py-10 sm:py-14">
    <nav aria-label="Fil d'Ariane" class="text-sm text-albizia-600">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={lien('/')} class="rounded hover:underline underline-offset-4">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={lien('/actualites')} class="rounded hover:underline underline-offset-4">
            Actualités
          </a>
        </li>
      </ol>
    </nav>

    <header class="mt-8 max-w-3xl">
      <time
        datetime={date.toISOString()}
        class="text-sm font-semibold uppercase tracking-wide text-terracotta-600"
      >
        {formaterDate(date)}
      </time>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-albizia-900 sm:text-4xl">
        {titre}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-albizia-700">{resume}</p>
    </header>

    <div
      class="prose-albizia mt-10 max-w-3xl space-y-4 leading-relaxed text-albizia-800 [&_a]:font-medium [&_a]:text-albizia-700 [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-albizia-900 [&_strong]:font-semibold [&_strong]:text-albizia-900"
    >
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-albizia-50 px-3 py-1 text-xs font-medium text-albizia-700">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <a
      href={lien('/actualites')}
      class="mt-10 inline-block rounded text-sm font-medium text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
    >
      ← Toutes les actualités
    </a>
  </article>
</BaseLayout>
