---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FondVideo from '../../components/FondVideo.astro';
import ContactAgence from '../../components/ContactAgence.astro';
import Icone from '../../components/Icone.astro';
import { schemaFilAriane, schemaLocal } from '../../lib/seo';
import {
  ADRESSE_COMPLETE,
  lien,
  SITE,
  STATUTS_LOCAL,
  type StatutLocal,
} from '../../lib/site';
import { formaterSurface, getLocaux } from '../../lib/contenu';

export async function getStaticPaths() {
  const locaux = await getLocaux();
  return locaux.map((local) => ({
    params: { id: local.id },
    props: { local },
  }));
}

const { local } = Astro.props;
const {
  reference,
  surface,
  statut,
  disponibilite,
  accroche,
  atouts,
  destinations,
  loyer,
  image,
  video,
  galerie,
} = local.data;

const { Content } = await render(local);

const badge = STATUTS_LOCAL[statut as StatutLocal];
const libelleSurface = formaterSurface(surface);
const siteUrl = Astro.site!.href;
const urlPage = new URL(`/locaux/${local.id}`, siteUrl).href;

const schemas = [
  schemaLocal({
    reference,
    description: accroche,
    url: urlPage,
    siteUrl,
    surface,
  }),
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Contact', url: new URL('/contact', siteUrl).href },
    { nom: reference, url: urlPage },
  ]),
];

/**
 * Le titre reprend la formulation d'une recherche réelle
 * (« local commercial 120 m² à louer Montech ») plutôt que la seule
 * référence interne, qui n'est tapée par personne.
 */
const titre = libelleSurface
  ? `Local commercial ${libelleSurface} à louer`
  : `${reference} — local commercial à louer`;
---

<BaseLayout
  titre={titre}
  description={`${accroche} ${reference}${
    libelleSurface ? `, ${libelleSurface}` : ''
  } à louer au ${SITE.nom}, ${ADRESSE_COMPLETE}. Disponibilité : ${disponibilite}.`}
  schemas={schemas}
>
  <!--
    Vidéo aérienne en en-tête, comme sur les autres pages du site. La photo
    de repérage n'y figure pas : recadrée en bandeau et assombrie par le
    voile, le cadre rouge qui signale le local y deviendrait illisible. Elle
    est donc montrée entière plus bas, à sa vraie taille.
  -->
  {
    video ? (
      <FondVideo nom={video} taille="bandeau">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/80">
          {badge.label} · {disponibilite}
        </p>
        <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-white drop-shadow-sm sm:text-4xl">
          {reference}
          {libelleSurface && <span class="text-white/85"> · {libelleSurface}</span>}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
          {accroche}
        </p>
      </FondVideo>
    ) : (
      <section class="bg-sable-50">
        <div class="conteneur py-10 sm:py-14">
          <p class="text-sm font-semibold uppercase tracking-wide text-terracotta-600">
            {badge.label} · {disponibilite}
          </p>
          <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-albizia-900 sm:text-4xl">
            {reference}
            {libelleSurface && (
              <span class="text-albizia-600"> · {libelleSurface}</span>
            )}
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-albizia-700">
            {accroche}
          </p>
        </div>
      </section>
    )
  }

  <div class="conteneur py-8 sm:py-12">
    <nav aria-label="Fil d'Ariane" class="text-sm text-albizia-600">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href={lien('/')} class="rounded hover:underline underline-offset-4">
            Accueil
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            href={lien('/contact#locaux')}
            class="rounded hover:underline underline-offset-4"
          >
            Locaux à louer
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-albizia-900" aria-current="page">
          {reference}
        </li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <!-- Colonne principale -->
      <div>
        {
          /*
            Situer le local dans le pôle : c'est la première question que se
            pose quelqu'un qui regarde l'annonce. Affichée entière et non
            recadrée, pour que le cadre rouge reste lisible.
          */
          image && (
            <figure class="mb-10">
              <Image
                src={image}
                alt={`Vue aérienne du ${SITE.nom}, ${reference} signalé par un cadre rouge`}
                widths={[600, 1000, 1600]}
                sizes="(min-width: 1024px) 700px, 96vw"
                loading="eager"
                class="w-full rounded-[--radius-card] border border-albizia-100 bg-white"
              />
              <figcaption class="mt-2.5 text-sm text-albizia-600">
                Emplacement de {reference} au sein du pôle, signalé par un
                cadre rouge.
              </figcaption>
            </figure>
          )
        }

        {
          atouts.length > 0 && (
            <section aria-labelledby="atouts">
              <h2
                id="atouts"
                class="text-xl font-bold tracking-tight text-albizia-900"
              >
                Les atouts du local
              </h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {atouts.map((atout) => (
                  <li class="flex items-start gap-2.5 rounded-lg border border-albizia-100 bg-white p-3.5 text-sm leading-relaxed text-albizia-800">
                    <Icone
                      nom="boutique"
                      class="mt-0.5 h-4 w-4 shrink-0 text-terracotta-600"
                    />
                    <span>{atout}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div
          class="prose-albizia mt-8 max-w-none space-y-4 leading-relaxed text-albizia-800 [&_a]:font-medium [&_a]:text-albizia-700 [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-4 [&_blockquote]:border-albizia-200 [&_blockquote]:pl-4 [&_blockquote]:text-sm [&_blockquote]:text-albizia-600 [&_strong]:font-semibold [&_strong]:text-albizia-900"
        >
          <Content />
        </div>

        {
          galerie.length > 0 && (
            <section class="mt-10" aria-labelledby="galerie">
              <h2
                id="galerie"
                class="text-xl font-bold tracking-tight text-albizia-900"
              >
                Le local en images
              </h2>
              <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                {galerie.map((vue) => (
                  <li>
                    <figure>
                      <div class="aspect-[4/3] overflow-hidden rounded-[--radius-card] bg-white">
                        <Image
                          src={vue.image}
                          alt={vue.legende ?? `Local ${reference}`}
                          widths={[400, 800]}
                          sizes="(min-width: 640px) 45vw, 92vw"
                          loading="lazy"
                          class="h-full w-full object-cover"
                        />
                      </div>
                      {vue.legende && (
                        <figcaption class="mt-2 text-sm text-albizia-600">
                          {vue.legende}
                        </figcaption>
                      )}
                    </figure>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!-- Colonne latérale : la fiche technique, telle qu'un porteur de projet la lit -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[--radius-card] border border-albizia-200 bg-white p-6">
          <h2 class="text-base font-semibold text-albizia-900">
            Caractéristiques
          </h2>

          <dl class="mt-4 space-y-4 text-sm">
            {
              libelleSurface && (
                <div class="flex justify-between gap-3">
                  <dt class="font-medium text-albizia-600">Surface</dt>
                  <dd class="font-semibold text-albizia-900">
                    {libelleSurface}
                  </dd>
                </div>
              )
            }

            <div class="flex justify-between gap-3">
              <dt class="font-medium text-albizia-600">Statut</dt>
              <dd class="font-semibold text-albizia-900">{badge.label}</dd>
            </div>

            <div class="flex justify-between gap-3">
              <dt class="font-medium text-albizia-600">Disponibilité</dt>
              <dd class="font-semibold text-albizia-900">{disponibilite}</dd>
            </div>

            <div class="flex justify-between gap-3">
              <dt class="font-medium text-albizia-600">Loyer</dt>
              <dd class="font-semibold text-albizia-900">
                {loyer ?? 'Sur demande'}
              </dd>
            </div>

            {
              destinations.length > 0 && (
                <div>
                  <dt class="font-medium text-albizia-600">
                    Activités envisageables
                  </dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {destinations.map((destination) => (
                      <span class="rounded-full bg-albizia-50 px-2.5 py-1 text-xs font-medium text-albizia-700">
                        {destination}
                      </span>
                    ))}
                  </dd>
                </div>
              )
            }

            <div class="border-t border-albizia-100 pt-4">
              <dt class="flex items-center gap-1.5 font-medium text-albizia-600">
                <Icone nom="localisation" class="h-4 w-4" />
                Adresse
              </dt>
              <dd class="mt-1 text-albizia-900">
                <address class="not-italic">
                  {SITE.nom}<br />
                  {ADRESSE_COMPLETE}
                </address>
              </dd>
            </div>
          </dl>

          <p class="mt-6 border-t border-albizia-100 pt-4 text-xs leading-relaxed text-albizia-600">
            Parking gratuit et accès de plain-pied sur l'ensemble du pôle.
            Surfaces données à titre indicatif, à vérifier lors de la visite.
          </p>
        </div>

        <a
          href={lien('/contact#locaux')}
          class="mt-4 inline-block rounded text-sm font-medium text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
        >
          ← Tous les locaux
        </a>
      </aside>
    </div>

    <ContactAgence reference={reference} class="mt-14" />
  </div>
</BaseLayout>
