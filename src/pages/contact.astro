---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import CarteLocal from '../components/CarteLocal.astro';
import ContactAgence from '../components/ContactAgence.astro';
import Icone from '../components/Icone.astro';
import { schemaFilAriane } from '../lib/seo';
import { ADRESSE_COMPLETE, AGENCE, CONTACT, SITE } from '../lib/site';
import { getCommerces, getLocaux, getLocauxDisponibles } from '../lib/contenu';

const locaux = await getLocaux();
const disponibles = await getLocauxDisponibles();
const commerces = await getCommerces();

const siteUrl = Astro.site!.href;
const urlPage = new URL('/contact', siteUrl).href;

const schemas = [
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Contact', url: urlPage },
  ]),
  ...(disponibles.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: `Locaux commerciaux à louer au ${SITE.nom}`,
          numberOfItems: disponibles.length,
          itemListElement: disponibles.map((l, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: l.data.reference,
            url: new URL(`/locaux/${l.id}`, siteUrl).href,
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  titre="Contact"
  description={`Contacter le ${SITE.nom} à Montech : informations sur le site, location d'un local commercial, mise à jour d'une fiche commerçant.`}
  schemas={schemas}
>
  <EnTetePage
    video="contact"
    titre="Nous contacter"
    intro="Une question sur le pôle, un local à louer, une fiche à corriger : voici comment nous joindre."
  />

  <div class="conteneur py-14 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-14">
      <section>
        <h2 class="text-xl font-bold tracking-tight text-albizia-900">
          Coordonnées
        </h2>

        <dl class="mt-5 space-y-5">
          <div>
            <dt class="flex items-center gap-1.5 text-sm font-medium text-albizia-600">
              <Icone nom="localisation" class="h-4 w-4" />
              Adresse
            </dt>
            <dd class="mt-1.5">
              <address class="not-italic leading-relaxed text-albizia-900">
                {SITE.nom}<br />
                {ADRESSE_COMPLETE}
              </address>
            </dd>
          </div>

          {
            CONTACT.telephone && (
              <div>
                <dt class="text-sm font-medium text-albizia-600">Téléphone</dt>
                <dd class="mt-1.5">
                  <a
                    href={`tel:${CONTACT.telephone.replace(/\s/g, '')}`}
                    class="rounded text-lg font-semibold text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                  >
                    {CONTACT.telephone}
                  </a>
                </dd>
              </div>
            )
          }

          {
            CONTACT.email && (
              <div>
                <dt class="text-sm font-medium text-albizia-600">Courriel</dt>
                <dd class="mt-1.5">
                  <a
                    href={`mailto:${CONTACT.email}`}
                    class="rounded break-all font-semibold text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                  >
                    {CONTACT.email}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        {
          !CONTACT.telephone && !CONTACT.email && (
            <p class="mt-5 rounded-lg border border-albizia-200 bg-sable-100 p-4 text-sm leading-relaxed text-albizia-700">
              Les coordonnées de contact du pôle seront publiées prochainement.
              En attendant, adressez-vous directement au commerce concerné —
              les liens figurent sur chaque fiche de l'annuaire.
            </p>
          )
        }
      </section>

      <section>
        <h2 class="text-xl font-bold tracking-tight text-albizia-900">
          Selon votre demande
        </h2>

        <ul class="mt-5 space-y-4">
          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              Vous cherchez un commerce
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              Chaque enseigne gère ses propres horaires et rendez-vous. Le plus
              rapide est de la contacter directement depuis sa fiche.
            </p>
            <a
              href="/commerces"
              class="mt-3 inline-block rounded text-sm font-semibold text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
            >
              Consulter l'annuaire →
            </a>
          </li>

          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              Vous souhaitez louer un local
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              {
                disponibles.length > 0
                  ? `${disponibles.length} ${
                      disponibles.length > 1
                        ? 'locaux sont disponibles'
                        : 'local est disponible'
                    } à la location. La commercialisation est confiée à ${AGENCE.nom}.`
                  : `Tous les locaux du pôle sont actuellement occupés. La commercialisation est confiée à ${AGENCE.nom}.`
              }
            </p>
            {
              disponibles.length > 0 && (
                <a
                  href="#locaux"
                  class="mt-3 inline-block rounded text-sm font-semibold text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
                >
                  Voir les locaux disponibles →
                </a>
              )
            }
          </li>

          <li class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
            <h3 class="font-semibold text-albizia-900">
              Vous êtes commerçant sur le pôle
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-albizia-700">
              Pour ajouter votre enseigne à l'annuaire, corriger une
              information ou signaler une actualité, faites-le nous savoir :
              votre fiche sera mise à jour.
            </p>
          </li>
        </ul>
      </section>
    </div>

    <!--
      Les locaux à louer. Rattachés à la page contact plutôt qu'à une section
      dédiée : la demande arrive par le même canal que les autres, et chaque
      local garde sa fiche pour le référencement (« local commercial 90 m²
      à louer Montech »).
    -->
    {
      locaux.length > 0 && (
        <section id="locaux" class="mt-16 scroll-mt-24 border-t border-albizia-100 pt-14">
          <h2 class="text-xl font-bold tracking-tight text-albizia-900 sm:text-2xl">
            Les locaux à louer
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-albizia-700">
            Rejoignez les {commerces.length} enseignes déjà installées au pôle
            commercial l'Albizia, à l'entrée de Montech. Parking gratuit et
            sans limite de durée, accès de plain-pied, et des services communs
            — casiers de retrait de colis, borne de recharge électrique — qui
            amènent du passage tout au long de la journée.
          </p>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {locaux.map((local) => (
              <li class="flex">
                <CarteLocal local={local} />
              </li>
            ))}
          </ul>

          <ContactAgence class="mt-10" />
        </section>
      )
    }
  </div>
</BaseLayout>
