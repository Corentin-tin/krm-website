---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Icone from '../components/Icone.astro';
import { Image } from 'astro:assets';
import logoMaps from '../assets/reseaux/google-maps.png';
import { schemaFilAriane, schemaPole } from '../lib/seo';
import { ADRESSE, ADRESSE_COMPLETE, HORAIRES, SITE } from '../lib/site';
import { getServices } from '../lib/contenu';

const services = await getServices();

const siteUrl = Astro.site!.href;
const schemas = [
  schemaPole(siteUrl, services.map((s) => s.data.nom)),
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Infos pratiques', url: new URL('/infos-pratiques', siteUrl).href },
  ]),
];

const requete = encodeURIComponent(`${SITE.nom}, ${ADRESSE_COMPLETE}`);
const lienItineraire = `https://www.google.com/maps/dir/?api=1&destination=${requete}`;
const lienCarte = `https://www.google.com/maps/search/?api=1&query=${requete}`;
---

<BaseLayout
  titre="Infos pratiques"
  description={`Adresse, accès, horaires et stationnement du ${SITE.nom}, ${ADRESSE_COMPLETE}. Parking gratuit et accès PMR.`}
  schemas={schemas}
>
  <EnTetePage
    video="infos-pratiques"
    titre="Infos pratiques"
    intro="Où nous trouver, comment venir, à quelle heure. Tout ce qu'il faut savoir avant de passer."
  />

  <div class="conteneur py-14 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <section>
        <h2 class="flex items-center gap-2 text-xl font-bold tracking-tight text-albizia-900">
          <Icone nom="localisation" class="h-5 w-5 text-albizia-600" />
          Adresse
        </h2>
        <address class="mt-4 not-italic text-lg leading-relaxed text-albizia-800">
          <strong class="font-semibold text-albizia-900">{SITE.nom}</strong><br />
          {ADRESSE.rue}<br />
          {ADRESSE.codePostal} {ADRESSE.ville}
        </address>
        <p class="mt-4 leading-relaxed text-albizia-700">
          Le pôle se situe en bordure de la <strong>RD 928</strong> (avenue de
          Montauban), dans la zone commerciale de la Mouscane, à l'entrée de
          Montech en venant de Montauban.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={lienItineraire}
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg bg-albizia-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-albizia-800"
          >
            <Image src={logoMaps} alt="" width={32} height={45} class="h-5 w-auto" />
            Calculer mon itinéraire
          </a>
          <a
            href={lienCarte}
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-albizia-300 bg-white px-5 py-3 text-sm font-semibold text-albizia-800 transition-colors hover:bg-albizia-50"
          >
            <Image src={logoMaps} alt="" width={32} height={45} class="h-5 w-auto" />
            Voir sur la carte
          </a>
        </div>
      </section>

      <section>
        <h2 class="flex items-center gap-2 text-xl font-bold tracking-tight text-albizia-900">
          <Icone nom="horloge" class="h-5 w-5 text-albizia-600" />
          Horaires du site
        </h2>
        <dl class="mt-4 divide-y divide-albizia-200 border-y border-albizia-200">
          {
            HORAIRES.jours.map((h) => (
              <div class="flex items-baseline justify-between gap-4 py-3">
                <dt class="text-albizia-700">{h.jours}</dt>
                <dd class="font-semibold text-albizia-900">{h.horaire}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm leading-relaxed text-albizia-600">
          {HORAIRES.mention}
        </p>
        <p class="mt-4 rounded-lg bg-terracotta-50 p-4 text-sm leading-relaxed text-terracotta-800">
          Le casier Mondial Relay, la borne de recharge et le
          distributeur automatique de pizzas restent accessibles
          <strong>24h/24 et 7j/7</strong>, en dehors de ces horaires.
        </p>
      </section>
    </div>

    <section class="mt-16">
      <h2 class="flex items-center gap-2 text-xl font-bold tracking-tight text-albizia-900">
        <Icone nom="parking" class="h-5 w-5 text-albizia-600" />
        Stationnement et accessibilité
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
          <h3 class="font-semibold text-albizia-900">Parking gratuit</h3>
          <p class="mt-2 text-sm leading-relaxed text-albizia-700">
            Stationnement gratuit sur site, sans disque ni limitation de durée,
            complété par les rues adjacentes.
          </p>
        </div>
        <div class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
          <h3 class="font-semibold text-albizia-900">Accès PMR</h3>
          <p class="mt-2 text-sm leading-relaxed text-albizia-700">
            Places dédiées près des entrées, cheminements de plain-pied et
            sanitaires adaptés.
          </p>
        </div>
        <div class="rounded-[--radius-card] border border-albizia-100 bg-white p-5">
          <h3 class="font-semibold text-albizia-900">Véhicules électriques</h3>
          <p class="mt-2 text-sm leading-relaxed text-albizia-700">
            Borne Powerdot avec trois points de charge rapide simultanés, en
            libre accès et sans abonnement.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
