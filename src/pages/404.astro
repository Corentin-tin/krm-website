---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lien } from '../lib/site';
---

<BaseLayout
  titre="Page introuvable"
  description="La page demandée n'existe pas ou a été déplacée."
  noindex
>
  <div class="conteneur py-20 sm:py-28">
    <p class="text-sm font-semibold uppercase tracking-wide text-terracotta-600">
      Erreur 404
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-albizia-900 sm:text-4xl">
      Cette page n'existe pas
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-albizia-700">
      La page que vous cherchez a peut-être été déplacée, ou l'adresse saisie
      comporte une erreur.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={lien('/')}
        class="rounded-lg bg-albizia-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-albizia-800"
      >
        Retour à l'accueil
      </a>
      <a
        href={lien('/commerces')}
        class="rounded-lg border border-albizia-300 bg-white px-5 py-3 text-sm font-semibold text-albizia-800 transition-colors hover:bg-albizia-50"
      >
        Voir les commerces
      </a>
    </div>
  </div>
</BaseLayout>
