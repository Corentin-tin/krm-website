---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Vignette from '../../components/Vignette.astro';
import Icone from '../../components/Icone.astro';
import { schemaCommerce, schemaFilAriane } from '../../lib/seo';
import { ADRESSE_COMPLETE, CATEGORIES, type CategorieId } from '../../lib/site';
import { getCommerces } from '../../lib/contenu';

export async function getStaticPaths() {
  const commerces = await getCommerces();
  return commerces.map((commerce) => ({
    params: { id: commerce.id },
    props: { commerce },
  }));
}

const { commerce } = Astro.props;
const { nom, categorie, accroche, telephone, email, siteWeb, reseaux, horaires, image, logo } =
  commerce.data;

const { Content } = await render(commerce);

const label = CATEGORIES[categorie as CategorieId]?.label ?? categorie;
const siteUrl = Astro.site!.href;
const urlPage = new URL(`/commerces/${commerce.id}`, siteUrl).href;

const schemas = [
  schemaCommerce({
    nom,
    description: accroche,
    url: urlPage,
    siteUrl,
    telephone,
    siteWeb,
  }),
  schemaFilAriane([
    { nom: 'Accueil', url: siteUrl },
    { nom: 'Les commerces', url: new URL('/commerces', siteUrl).href },
    { nom, url: urlPage },
  ]),
];
---

<BaseLayout
  titre={nom}
  description={`${accroche} ${nom} vous accueille au pôle commercial l'Albizia, ${ADRESSE_COMPLETE}. Parking gratuit.`}
  schemas={schemas}
>
  <div class="conteneur py-8 sm:py-12">
    <nav aria-label="Fil d'Ariane" class="text-sm text-albizia-600">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="rounded hover:underline underline-offset-4">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/commerces" class="rounded hover:underline underline-offset-4">
            Les commerces
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-albizia-900" aria-current="page">{nom}</li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <!-- Colonne principale -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-terracotta-600">
          {label}
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-albizia-900 sm:text-4xl">
          {nom}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-albizia-700">{accroche}</p>

        <div class="mt-8 aspect-[16/9] overflow-hidden rounded-[--radius-card] bg-white">
          <Vignette nom={nom} categorie={categorie} image={image} logo={logo} prioritaire />
        </div>

        <div
          class="prose-albizia mt-8 max-w-none space-y-4 leading-relaxed text-albizia-800 [&_a]:font-medium [&_a]:text-albizia-700 [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-4 [&_blockquote]:border-albizia-200 [&_blockquote]:pl-4 [&_blockquote]:text-sm [&_blockquote]:text-albizia-600 [&_strong]:font-semibold [&_strong]:text-albizia-900"
        >
          <Content />
        </div>
      </div>

      <!-- Colonne latérale : informations pratiques -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[--radius-card] border border-albizia-200 bg-white p-6">
          <h2 class="text-base font-semibold text-albizia-900">
            Informations pratiques
          </h2>

          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="flex items-center gap-1.5 font-medium text-albizia-600">
                <Icone nom="localisation" class="h-4 w-4" />
                Adresse
              </dt>
              <dd class="mt-1 text-albizia-900">
                <address class="not-italic">
                  Pôle commercial l'Albizia<br />
                  {ADRESSE_COMPLETE}
                </address>
              </dd>
            </div>

            {
              telephone && (
                <div>
                  <dt class="font-medium text-albizia-600">Téléphone</dt>
                  <dd class="mt-1">
                    <a
                      href={`tel:${telephone.replace(/\s/g, '')}`}
                      class="rounded font-medium text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                    >
                      {telephone}
                    </a>
                  </dd>
                </div>
              )
            }

            {
              email && (
                <div>
                  <dt class="font-medium text-albizia-600">Courriel</dt>
                  <dd class="mt-1">
                    <a
                      href={`mailto:${email}`}
                      class="rounded break-all font-medium text-albizia-900 underline underline-offset-4 hover:text-terracotta-600"
                    >
                      {email}
                    </a>
                  </dd>
                </div>
              )
            }

            {
              horaires && horaires.length > 0 && (
                <div>
                  <dt class="flex items-center gap-1.5 font-medium text-albizia-600">
                    <Icone nom="horloge" class="h-4 w-4" />
                    Horaires
                  </dt>
                  <dd class="mt-1">
                    <ul class="space-y-1">
                      {horaires.map((h) => (
                        <li class="flex justify-between gap-3 text-albizia-900">
                          <span>{h.jours}</span>
                          <span class="font-medium">{h.horaire}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>

          {
            (siteWeb || (reseaux && reseaux.length > 0)) && (
              <div class="mt-6 space-y-2 border-t border-albizia-100 pt-5">
                {siteWeb && (
                  <a
                    href={siteWeb}
                    rel="noopener"
                    class="block rounded-lg bg-albizia-700 px-4 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-albizia-800"
                  >
                    Visiter le site web
                  </a>
                )}
                {reseaux?.map((lien) => (
                  <a
                    href={lien.url}
                    rel="noopener"
                    class="block rounded-lg border border-albizia-300 px-4 py-2.5 text-center text-sm font-semibold text-albizia-800 transition-colors hover:bg-albizia-50"
                  >
                    {lien.nom}
                  </a>
                ))}
              </div>
            )
          }

          <p class="mt-6 border-t border-albizia-100 pt-4 text-xs leading-relaxed text-albizia-600">
            Parking gratuit et accès de plain-pied sur l'ensemble du pôle.
          </p>
        </div>

        <a
          href="/commerces"
          class="mt-4 inline-block rounded text-sm font-medium text-albizia-700 underline underline-offset-4 hover:text-terracotta-600"
        >
          ← Tous les commerces
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>
